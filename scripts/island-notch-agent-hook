#!/usr/bin/env python3
"""Antigravity lifecycle hook bridge for island-notch.

Reads hook JSON payload from stdin, spawns a detached background IPC update to
island-notch, and immediately prints {} to stdout so the agent loop never stalls.
"""
import json
import os
import subprocess
import sys

event = sys.argv[1] if len(sys.argv) > 1 else ""
raw = ""
try:
    if not sys.stdin.isatty():
        raw = sys.stdin.read()
except Exception:
    raw = ""

payload = {}
if raw.strip():
    try:
        payload = json.loads(raw)
    except Exception:
        payload = {}

phase = ""
label = ""

if event == "PreInvocation":
    phase = "thinking"
    label = "AI Thinking..."
elif event == "PostToolUse":
    step_idx = payload.get("stepIdx")
    err = payload.get("error")
    phase = "tooling"
    if err:
        label = f"Step {step_idx} retry" if step_idx is not None else "Working..."
    else:
        label = f"Working · step {step_idx}" if step_idx is not None else "Working..."
elif event == "Stop":
    err = str(payload.get("error") or "").strip()
    term = str(payload.get("terminationReason") or "").strip()
    if err or term == "error":
        phase = "error"
        label = err[:54] if err else "Agent terhenti"
    else:
        phase = "done"
        label = ""

bin_path = os.path.expanduser("~/.local/bin/island-notch")
if phase and os.path.exists(bin_path):
    try:
        subprocess.Popen(
            [bin_path, "ipc", "call", "notch", "setAgentStatus", phase, label],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass

sys.stdout.write("{}\n")
sys.stdout.flush()
